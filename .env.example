# =====================================================================
# Play Anything in Browser — Environment Configuration
# Heavy 3D GPU game runs on the remote server; your laptop only streams video
# =====================================================================

# 1. Remote GPU Server Address
# When set, the local browser UI wires input/video directly to this remote IP
REMOTE_GPU_HOST=
REMOTE_GPU_PORT=18080
STREAM_PROTOCOL=http

# 2. Local Web Client & Gateway
PORT=8000
API_TOKEN=

# 3. GCP Cloud Automation (Using your GCP credits)
# Paste your raw Service Account JSON here (single-line or path to key file)
# Example: GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"my-project",...}
GOOGLE_SERVICE_ACCOUNT_JSON=
GCP_PROJECT_ID=visiblie-dev
GCP_ZONE=us-central1-a
GCP_GPU_TYPE=nvidia-l4
